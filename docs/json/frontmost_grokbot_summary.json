{
  "title": "FrontmostIfGrokBot_summary",
  "rules": [
    {
      "description": "FrontmostIfGrokBot_summary",
      "manipulators": [
        {
          "description": "LeftCommand + ,(カンマ)_SwitchBot(Control+Tab)",
          "type": "basic",
          "from": {
            "key_code": "comma",
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "tab",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anysphere\\.sand$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
