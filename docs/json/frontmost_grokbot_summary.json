{
  "title": "FrontmostIfGrokBot_summary2",
  "rules": [
    {
      "description": "FrontmostIfGrokBot_summary2",
      "manipulators": [
        {
          "description": "LeftCommand + ,(カンマ)_SwitchBot(Control+Tab)",
          "type": "basic",
          "from": {
            "key_code": "comma",
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "tab",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anysphere\\.sand$"
              ]
            }
          ]
        },
        {
          "description": "LeftCommand + T_SidebarCompact(Cmd+B)",
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "b",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anysphere\\.sand$"
              ]
            }
          ]
        },
        {
          "description": "LeftOption + I_FocusChat(Cmd+I)",
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": {
              "mandatory": [
                "left_option"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "i",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anysphere\\.sand$"
              ]
            }
          ]
        },
        {
          "description": "RightCommand + I_Details(Shift+Cmd+I)",
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": {
              "mandatory": [
                "right_command"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "i",
              "modifiers": [
                "left_shift",
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anysphere\\.sand$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
